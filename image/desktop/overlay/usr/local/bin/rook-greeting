#!/bin/bash
# rook-greeting - the banner printed into the welcome terminal.
#
# Rook is not an interactive agent: each run takes a task and an authorization
# scope. So this desktop opens a shell rather than an agent, and the greeting is
# how a researcher learns to drive it - including whether an API key is set yet.

set -uo pipefail

crimson='\033[38;2;222;59;75m'
white='\033[38;2;245;246;248m'
muted='\033[38;2;110;114;128m'
reset='\033[0m'

key_ready() {
    # A non-empty authorization value (the seeded template has an empty one).
    grep -qE "authorization:[[:space:]]*['\"]?[^'\"[:space:]]" \
        "${HOME}/.config/rook/config.yaml" 2>/dev/null
}

printf '\n'
printf "${crimson}  ▟█▙ Rook${reset} ${muted}— AI bug-hunting harness${reset}\n\n"

if key_ready; then
    printf "${white}  Ready.${reset} ${muted}Give it a task and an explicit scope:${reset}\n\n"
else
    printf "${crimson}  No key set.${reset} ${muted}Run${reset} ${white}rook config${reset} ${muted}to set your backend, model and provider key.${reset}\n\n"
fi

printf "${muted}    rook --scope \"web: https://staging.example.com, authorized pentest, non-destructive\" \\\\\n"
printf "         \"Full pentest of staging.example.com: recon, auth and access control,\n"
printf "          injection, SSRF, IDOR and business-logic flaws - verify each finding\n"
printf "          and deliver a report with reproductions and severity\"${reset}\n\n"

printf "${muted}    rook --scope-file engagement.txt \\\\\n"
printf "         \"Run the authorized engagement in engagement.txt end to end: map the\n"
printf "          attack surface, chain and verify exploitable issues, and write up the\n"
printf "          kill chain with remediation\"${reset}\n\n"

printf "${muted}  Authorized use only. Always pass an explicit --scope describing the${reset}\n"
printf "${muted}  systems you are permitted to assess. The workspace is /workspace.${reset}\n"
printf "${muted}  Ctrl-Shift-G opens another terminal. \`rook version\` for the build.${reset}\n\n"

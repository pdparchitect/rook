# Copy to .env and fill in. Rook loads .env from the working directory on
# startup, purely as a convenience for populating the environment. The primary
# configuration surface is ~/.config/rook/config.yaml - see
# configs/rook.example.yaml.

# Default provider key for the "relay" backend (your OpenAI/OpenRouter key).
# The relay authenticates each model with a provider key carried in the model
# string; this is the default applied to every relay model. For per-provider
# keys, set them per model in the config file instead.
RELAY_API_KEY=

# Bearer credentials for the ChatBotKit backends (same value, own variable):
#   rook --backend cbk         uses CBK_API_SECRET
#   rook --backend chatbotkit  uses CHATBOTKIT_API_SECRET
# CBK_API_SECRET=
# CHATBOTKIT_API_SECRET=
